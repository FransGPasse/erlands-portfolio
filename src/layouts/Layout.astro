---
import { withBase } from "../lib/withBase";
import "../styles/global.css";

const outfitFontFile = withBase("fonts/Outfit-VariableFont_wght.ttf");
const phosphorFontFile = withBase("fonts/Phosphor.woff2");
const faviconHref = withBase("favicon.svg");
---

<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link
      rel="preload"
      href={phosphorFontFile}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={outfitFontFile}
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Erland Gustavson Påsse</title>
  </head>
  <body class="min-h-screen bg-neutral-950">
    <style
      is:inline
      set:html={`@font-face{font-family:"Outfit";src:url("${outfitFontFile}") format("truetype");font-weight:100 900;font-style:normal;font-display:block;}@font-face{font-family:"Phosphor";src:url("${phosphorFontFile}") format("woff2");font-weight:normal;font-style:normal;font-display:block;}`}
    />
    <div
      id="cursor"
      class="custom-cursor pointer-events-none fixed left-0 top-0 z-[9999] size-3 rounded-full bg-white/75 opacity-0 mix-blend-difference transition-[left,top,opacity,transform] duration-100 ease-out"
      style="transform: translate(-50%, -50%)"
      aria-hidden="true"
    >
    </div>
    <slot />
  </body>

  <script>
    const cursor = document.getElementById("cursor");
    const hasFinePointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;

    if (cursor && hasFinePointer) {
      let isReady = false;
      let pressTimeout: ReturnType<typeof setTimeout> | undefined;

      const setScale = (scale: number) => {
        cursor.style.transform = `translate(-50%, -50%) scale(${scale})`;
      };

      const placeCursor = (x: number, y: number) => {
        cursor.style.left = `${x}px`;
        cursor.style.top = `${y}px`;
      };

      document.addEventListener("mousemove", (e: MouseEvent) => {
        if (!isReady) {
          cursor.style.transition = "none";
          placeCursor(e.clientX, e.clientY);
          // Force layout so the next frame can transition from the real position.
          void cursor.offsetWidth;
          cursor.style.transition = "";
          cursor.style.opacity = "1";
          isReady = true;
          return;
        }

        requestAnimationFrame(() => {
          placeCursor(e.clientX, e.clientY);
        });
      });

      document.documentElement.addEventListener("mouseleave", () => {
        if (isReady) cursor.style.opacity = "0";
      });

      document.documentElement.addEventListener("mouseenter", () => {
        if (isReady) cursor.style.opacity = "1";
      });

      document.addEventListener("click", () => {
        if (pressTimeout) clearTimeout(pressTimeout);
        setScale(0.7);
        pressTimeout = setTimeout(() => setScale(1), 100);
      });
    }
  </script>
</html>

<style is:global>
  .custom-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .custom-cursor {
      display: block;
    }
  }
</style>
