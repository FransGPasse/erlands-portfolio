---
import { withBase } from "../lib/withBase";

type Props = {
  src: string;
  text: string;
  icon: string;
};

const { src, text, icon } = Astro.props as Props;

const href = src.startsWith("http") ? src : withBase(src);
---

<a
  href={href}
  class="group inline-flex items-center gap-2 p-2 text-lg text-slate-100 transition-all duration-300 ease-in-out"
>
  <i class:list={["ph", icon, "text-xl opacity-70"]} aria-hidden="true"></i>
  <span>{text}</span>
  <span class="invisible group-hover:visible" aria-hidden="true">&rarr;</span>
</a>
