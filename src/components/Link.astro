---
import { withBase } from "../lib/withBase";

const props = Astro.props;
const { src, text } = props;

const href = src.startsWith("http") ? src : withBase(src);
---

<a
  href={href}
  class="text-slate-100 transition-all duration-300 ease-in-out group p-2 text-lg"
>
  {text}
  <span class="invisible group-hover:visible">&rarr;</span>
</a>
