---
import { withBase } from "../lib/withBase";

type Props = {
  src: string;
  text: string;
  icon: string;
};

const { src, text, icon } = Astro.props as Props;

const href = src.startsWith("http") ? src : withBase(src);
---

<a
  href={href}
  class="group inline-flex items-center gap-1 p-2 text-lg transition-colors duration-300 ease-in-out"
>
  <i class:list={["ph", icon, "text-xl opacity-70"]} aria-hidden="true"></i>
  <span
    class="underline decoration-transparent decoration-1 underline-offset-[0.35em] transition-[text-decoration-color] duration-300 group-hover:decoration-current"
  >
    {text}
  </span>
</a>
