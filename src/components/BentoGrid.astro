---
import type { Photo } from "../data/photos";

type Props = {
  photos: Photo[];
};

const { photos } = Astro.props as Props;

const bentoSpans = [
  "col-span-2 row-span-2",
  "col-span-1 row-span-1",
  "col-span-1 row-span-2",
  "col-span-1 row-span-1",
  "col-span-2 row-span-1",
  "col-span-1 row-span-1",
  "col-span-1 row-span-1",
  "col-span-2 row-span-2",
  "col-span-1 row-span-1",
  "col-span-1 row-span-2",
  "col-span-2 row-span-1",
  "col-span-1 row-span-1",
];
---

<div
  id="bento-view"
  class="grid w-full max-w-7xl auto-rows-[9.5rem] grid-flow-dense grid-cols-2 gap-4 sm:auto-rows-[11rem] md:auto-rows-[13rem] md:grid-cols-4 md:gap-5 lg:max-w-[88rem] lg:auto-rows-[15rem] lg:gap-6"
>
  {
    photos.map((photo, index) => (
      <figure
        class:list={[
          bentoSpans[index % bentoSpans.length],
          "bento-item group cursor-pointer overflow-hidden rounded-sm",
        ]}
        id={`photo-${photo.number}`}
        data-bento-item
        data-photo-index={index}
        role="button"
        tabindex="0"
        aria-label={`Open ${photo.alt}`}
      >
        <img
          src={photo.src}
          alt={photo.alt}
          class="size-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.04]"
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </figure>
    ))
  }
</div>

<style>
  .bento-item {
    opacity: 0;
    transform: translateY(2rem);
    pointer-events: none;
    transition:
      opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .bento-item.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-item {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>("[data-bento-item]");
  const scrollRoot = document.getElementById("photos-scroll");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function revealItem(item: HTMLElement) {
    item.classList.add("is-visible");
  }

  function isItemInScrollView(item: HTMLElement): boolean {
    if (!scrollRoot) return true;

    const itemRect = item.getBoundingClientRect();
    const rootRect = scrollRoot.getBoundingClientRect();

    return itemRect.bottom > rootRect.top && itemRect.top < rootRect.bottom;
  }

  function revealVisibleItems() {
    items.forEach((item) => {
      if (item.classList.contains("is-visible")) return;
      if (!isItemInScrollView(item)) return;

      revealItem(item);
      observer?.unobserve(item);
    });
  }

  let observer: IntersectionObserver | undefined;

  if (items.length > 0 && !prefersReducedMotion) {
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          revealItem(entry.target as HTMLElement);
          observer?.unobserve(entry.target);
        });
      },
      {
        root: scrollRoot,
        rootMargin: "120px 0px 120px 0px",
        threshold: 0.01,
      },
    );

    items.forEach((item) => observer?.observe(item));

    scrollRoot?.addEventListener("scroll", revealVisibleItems, { passive: true });
    document.addEventListener("photos:scroll-restored", revealVisibleItems);

    requestAnimationFrame(() => requestAnimationFrame(revealVisibleItems));
    setTimeout(revealVisibleItems, 150);
  } else {
    items.forEach((item) => revealItem(item));
  }

  function openPhoto(index: number) {
    document.dispatchEvent(
      new CustomEvent("gallery:open", { detail: { index } }),
    );
  }

  items.forEach((item) => {
    const index = Number(item.dataset.photoIndex);
    if (Number.isNaN(index)) return;

    item.addEventListener("click", () => openPhoto(index));
    item.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openPhoto(index);
      }
    });
  });
</script>
