---
import { navLinks } from "../data/nav";
import MenuToggle from "./MenuToggle.astro";
import NavLink from "./NavLink.astro";
import NavUnderline from "./NavUnderline.astro";

const menuId = "site-menu";
---

<nav
  class="absolute bottom-8 right-8 z-chrome hidden md:bottom-10 md:right-10 md:block lg:bottom-12 lg:right-12"
  aria-label="Main menu"
>
  <NavUnderline
    class="flex flex-wrap items-center justify-end gap-2 lg:gap-3"
  >
    {
      navLinks.map((link) => (
        <NavLink
          href={link.href}
          label={link.label}
          icon={link.icon}
          layout="desktop"
        />
      ))
    }
  </NavUnderline>
</nav>

<MenuToggle controls={menuId} />

<div
  id={menuId}
  class="mobile-menu group/menu fixed inset-0 z-overlay md:hidden"
  hidden
  aria-hidden="true"
>
  <nav
    class="mobile-menu__nav flex size-full scale-[0.98] items-center justify-center bg-neutral-950 opacity-0 transition-[opacity,transform] duration-400 ease-smooth motion-reduce:scale-100 motion-reduce:transition-none group-[.is-open]/menu:scale-100 group-[.is-open]/menu:opacity-100"
    aria-label="Main menu"
  >
    <NavUnderline>
      <ul class="flex flex-col items-center gap-2 sm:gap-3">
        {
          navLinks.map((link, index) => (
            <NavLink
              href={link.href}
              label={link.label}
              icon={link.icon}
              layout="mobile"
              index={index}
            />
          ))
        }
      </ul>
    </NavUnderline>
  </nav>
</div>

<style>
  .mobile-menu {
    pointer-events: none;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu__nav {
    touch-action: manipulation;
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("site-menu");

  if (toggle && menu) {
    let isOpen = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const CLOSE_MS = 400;

    const setOpen = (open: boolean) => {
      if (open === isOpen) return;
      isOpen = open;

      if (closeTimer !== undefined) {
        clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.classList.toggle("is-open", open);
      document.body.classList.toggle("overflow-hidden", open);
      menu.setAttribute("aria-hidden", String(!open));

      if (open) {
        menu.hidden = false;
        void menu.offsetWidth;
        requestAnimationFrame(() => {
          if (!isOpen) return;
          menu.classList.add("is-open");
        });
        return;
      }

      menu.classList.remove("is-open");
      closeTimer = setTimeout(() => {
        if (!isOpen) menu.hidden = true;
        closeTimer = undefined;
      }, CLOSE_MS);
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!isOpen);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) setOpen(false);
    });

    const desktopMq = window.matchMedia("(min-width: 768px)");
    desktopMq.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
