---
type Props = {
  controls: string;
};

const { controls } = Astro.props as Props;
---

<button
  type="button"
  id="menu-toggle"
  class="menu-toggle fixed right-5 top-5 z-toggle flex size-11 items-center justify-center transition-opacity duration-300 hover:opacity-70 active:scale-95 sm:right-8 sm:top-8 sm:size-12 md:hidden"
  aria-expanded="false"
  aria-controls={controls}
  aria-label="Open menu"
>
  <span class="menu-toggle__icon" aria-hidden="true">
    <span class="menu-toggle__line menu-toggle__line--top"></span>
    <span class="menu-toggle__line menu-toggle__line--middle"></span>
    <span class="menu-toggle__line menu-toggle__line--bottom"></span>
  </span>
</button>

<style>
  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.2rem;
    height: 0.75rem;
  }

  .menu-toggle__line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 9999px;
    background-color: currentColor;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-toggle__line--top {
    top: 0;
    transform-origin: center;
  }

  .menu-toggle__line--middle {
    top: 50%;
    transform: translateY(-50%);
    transform-origin: center;
  }

  .menu-toggle__line--bottom {
    bottom: 0;
    transform-origin: center;
  }

  .menu-toggle.is-open .menu-toggle__line--top {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .menu-toggle.is-open .menu-toggle__line--middle {
    opacity: 0;
    transform: translateY(-50%) scaleX(0);
  }

  .menu-toggle.is-open .menu-toggle__line--bottom {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__line {
      transition: none;
    }
  }
</style>
