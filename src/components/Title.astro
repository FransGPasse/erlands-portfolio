---
interface Props {
  as?: "h1" | "h2" | "h3" | "p" | "span";
  class?: string;
  id?: string;
}

const { as: Tag = "h1", class: className, id }: Props = Astro.props;
---

<Tag
  id={id}
  class:list={[
    "[font-variation-settings:'wght'_500] transition-[font-variation-settings] duration-300 ease-in-out hover:[font-variation-settings:'wght'_800]",
    className,
  ]}
>
  <slot />
</Tag>
