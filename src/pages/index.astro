---
import Layout from "../layouts/Layout.astro";
import MainNav from "../components/MainNav.astro";
import Title from "../components/Title.astro";
import { withBase } from "../lib/withBase";

const heroSrc = withBase("photos/landing-page-image.webp");
---

<Layout>
  <main class="relative min-h-dvh overflow-hidden">
    <img
      src={heroSrc}
      alt="Photo 32"
      class="absolute inset-0 z-0 size-full object-cover object-center opacity-0 animate-hero-blur-fade motion-reduce:animate-none motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:scale-100"
      fetchpriority="high"
    />

    <header class="absolute inset-x-0 top-0 z-chrome p-5 sm:p-8 md:p-10">
      <Title
        class="max-w-[10rem] text-left text-2xl leading-tight opacity-0 animate-fade-slide-in sm:text-3xl md:text-4xl lg:text-5xl motion-reduce:animate-none motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:translate-y-0"
      >
        Erland Gustavson Påsse
      </Title>
    </header>

    <MainNav />
  </main>
</Layout>
