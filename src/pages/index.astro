---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
import { withBase } from "../lib/withBase";

const heroSrc = withBase("photos/landing-page-image.webp");

const navLinks = [
  { href: withBase("about-me/"), label: "About", icon: "ph-user" },
  { href: withBase("films/"), label: "Film", icon: "ph-film-strip" },
  { href: withBase("photos/"), label: "Photos", icon: "ph-camera" },
];
---

<Layout>
  <main class="relative min-h-dvh overflow-hidden">
    <img
      src={heroSrc}
      alt="Photo 32"
      class="hero-image absolute inset-0 size-full object-cover object-center"
      fetchpriority="high"
    />

    <header class="absolute inset-x-0 top-0 z-30 p-5 sm:p-8 md:p-10">
      <h1
        class="name-reveal title-weight max-w-[10.5rem] text-left text-2xl leading-tight text-white drop-shadow-[0_2px_16px_rgba(0,0,0,0.45)] sm:max-w-[18rem] sm:text-3xl md:max-w-none md:text-4xl lg:text-5xl"
      >
        Erland Gustavson Påsse
      </h1>
    </header>

    <nav
      class="absolute bottom-8 right-8 z-30 hidden md:flex md:flex-wrap md:justify-end md:gap-1 md:bottom-10 md:right-10"
      aria-label="Main menu"
    >
      <Link src="/about-me/" text="About" icon="ph-user" />
      <Link src="/films/" text="Film" icon="ph-film-strip" />
      <Link src="/photos/" text="Photos" icon="ph-camera" />
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="menu-toggle absolute right-5 top-5 z-50 flex size-11 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white shadow-[0_8px_30px_rgba(0,0,0,0.25)] backdrop-blur-md transition-[background-color,border-color,transform] duration-300 hover:border-white/35 hover:bg-white/15 active:scale-95 sm:right-8 sm:top-8 sm:size-12 md:hidden"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span class="menu-icon" aria-hidden="true">
        <span class="menu-icon__line menu-icon__line--top"></span>
        <span class="menu-icon__line menu-icon__line--mid"></span>
        <span class="menu-icon__line menu-icon__line--bot"></span>
      </span>
    </button>

    <div
      id="site-menu"
      class="site-menu fixed inset-0 z-40 md:hidden"
      hidden
      aria-hidden="true"
    >
      <div class="site-menu__backdrop absolute inset-0 bg-neutral-950/60 backdrop-blur-xl">
      </div>

      <div class="site-menu__cut-fill" aria-hidden="true"></div>

      <nav
        class="site-menu__panel absolute inset-4 flex items-center justify-center rounded-[2rem] border border-white/15 bg-white/10 shadow-[0_30px_80px_rgba(0,0,0,0.35)] backdrop-blur-2xl sm:inset-6 sm:rounded-[2.5rem]"
        aria-label="Main menu"
      >
        <ul class="flex flex-col items-center gap-2 sm:gap-3">
          {
            navLinks.map((link) => (
              <li class="site-menu__item">
                <a
                  href={link.href}
                  class="site-menu__link group inline-flex items-center justify-center gap-3 px-6 py-3 text-center text-3xl font-[500] tracking-wide text-white transition-opacity duration-300 hover:opacity-80 sm:text-4xl sm:py-4"
                >
                  <i
                    class:list={["ph", link.icon, "text-[0.9em] opacity-70"]}
                    aria-hidden="true"
                  ></i>
                  <span
                    class="underline decoration-transparent decoration-1 underline-offset-[0.35em] transition-[text-decoration-color] duration-300 group-hover:decoration-current"
                  >
                    {link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </main>
</Layout>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("site-menu");

  if (toggle && menu) {
    let isOpen = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const CLOSE_MS = 520;

    const setOpen = (open: boolean) => {
      if (open === isOpen) return;
      isOpen = open;

      if (closeTimer !== undefined) {
        clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
      menu.setAttribute("aria-hidden", String(!open));

      if (open) {
        menu.hidden = false;
        void menu.offsetWidth;
        requestAnimationFrame(() => {
          if (!isOpen) return;
          menu.classList.add("is-open");
        });
        return;
      }

      menu.classList.remove("is-open");
      closeTimer = setTimeout(() => {
        if (!isOpen) menu.hidden = true;
        closeTimer = undefined;
      }, CLOSE_MS);
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!isOpen);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) setOpen(false);
    });

    const desktopMq = window.matchMedia("(min-width: 768px)");
    desktopMq.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  @keyframes fade-slide-in {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(-1.25rem);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @keyframes hero-blur-fade {
    from {
      opacity: 0;
      filter: blur(28px);
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-image {
    opacity: 0;
    animation: hero-blur-fade 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .name-reveal {
    opacity: 0;
    animation: fade-slide-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  .menu-icon {
    display: block;
    position: relative;
    width: 1.2rem;
    height: 0.75rem;
  }

  .menu-icon__line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 999px;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease,
      top 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-icon__line--top {
    top: 0;
  }

  .menu-icon__line--mid {
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-icon__line--bot {
    top: 100%;
    transform: translateY(-100%);
  }

  .menu-toggle.is-open .menu-icon__line--top {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .menu-toggle.is-open .menu-icon__line--mid {
    opacity: 0;
  }

  .menu-toggle.is-open .menu-icon__line--bot {
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  .site-menu {
    --pad: 1.25rem;
    --panel-inset: 1rem;
    --btn: 2.75rem;
    --cut-gap: 0.55rem;
    --btn-center: calc(var(--pad) + var(--btn) / 2);
    --cut-r: calc(var(--btn) / 2 + var(--cut-gap));
    --panel-cut: calc(var(--btn-center) - var(--panel-inset));
    --menu-fill: rgb(255 255 255 / 0.1);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .site-menu {
      --pad: 2rem;
      --panel-inset: 1.5rem;
      --btn: 3rem;
    }
  }

  /* Menu-colored disc in the cutout — same fill/blur as the panel */
  .site-menu__cut-fill {
    position: absolute;
    top: var(--btn-center);
    right: var(--btn-center);
    width: calc(var(--cut-r) * 2);
    height: calc(var(--cut-r) * 2);
    border-radius: 999px;
    background: var(--menu-fill);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    transform: translate(50%, -50%);
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-menu__panel {
    -webkit-mask-image: radial-gradient(
      circle var(--cut-r) at calc(100% - var(--panel-cut)) var(--panel-cut),
      transparent 99%,
      #000 100%
    );
    mask-image: radial-gradient(
      circle var(--cut-r) at calc(100% - var(--panel-cut)) var(--panel-cut),
      transparent 99%,
      #000 100%
    );
  }

  .site-menu__backdrop,
  .site-menu__panel {
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-menu__panel {
    transform: scale(0.96);
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-menu.is-open {
    pointer-events: auto;
  }

  .site-menu.is-open .site-menu__backdrop,
  .site-menu.is-open .site-menu__panel,
  .site-menu.is-open .site-menu__cut-fill {
    opacity: 1;
  }

  .site-menu.is-open .site-menu__panel {
    transform: scale(1);
  }

  .site-menu__item {
    opacity: 0;
  }

  .site-menu.is-open .site-menu__item {
    animation: menu-item-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .site-menu.is-open .site-menu__item:nth-child(1) {
    animation-delay: 0.12s;
  }

  .site-menu.is-open .site-menu__item:nth-child(2) {
    animation-delay: 0.2s;
  }

  .site-menu.is-open .site-menu__item:nth-child(3) {
    animation-delay: 0.28s;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .name-reveal {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }

    .menu-icon__line,
    .site-menu__backdrop,
    .site-menu__panel,
    .site-menu__cut-fill {
      transition: none;
    }

    .site-menu.is-open .site-menu__item {
      opacity: 1;
      animation: none;
    }

    .site-menu__panel {
      transform: none;
    }
  }
</style>
