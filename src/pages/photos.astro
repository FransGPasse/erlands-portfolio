---
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { getPhotos } from "../data/photos";

const photos = getPhotos();
---

<Layout>
  <div
    id="photos-scroll"
    class="relative z-10 min-h-screen overflow-y-auto scroll-smooth"
  >
    <div class="flex flex-col items-center gap-6 px-6 py-10 sm:px-10 sm:py-14 md:py-16">
      <div class="w-full max-w-6xl">
        <PageHeader text="Photos" />
      </div>

      <PhotoGallery photos={photos} />
    </div>
  </div>
</Layout>

<script>
  import {
    restorePhotosScroll,
    savePhotosScroll,
  } from "../lib/photosScroll";

  const scrollRoot = document.getElementById("photos-scroll");

  let scrollSaveTimer: ReturnType<typeof setTimeout> | undefined;

  scrollRoot?.addEventListener(
    "scroll",
    () => {
      if (scrollSaveTimer) clearTimeout(scrollSaveTimer);
      scrollSaveTimer = setTimeout(() => savePhotosScroll(scrollRoot), 100);
    },
    { passive: true },
  );

  window.addEventListener("pagehide", () => savePhotosScroll(scrollRoot));

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      restorePhotosScroll(scrollRoot);
    }
  });

  requestAnimationFrame(() => {
    requestAnimationFrame(() => restorePhotosScroll(scrollRoot));
  });
</script>
